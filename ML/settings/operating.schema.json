{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Рабочие настройки ML-контура (operating.json)",
  "description": "Что читает сервис tf-model; файлы history/operating-*.json несут version/changed/changed_by/reason.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "changed", "changed_by", "reason", "horizon_hours",
               "shares", "reject_k", "reject_types", "max_share",
               "threshold_window_days", "chatter_gap_hours", "mute_max_hours"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "changed": {"type": "string", "format": "date-time"},
    "changed_by": {"type": "string"},
    "reason": {"type": "string"},
    "horizon_hours": {"type": "integer", "minimum": 1},
    "shares": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fire", "gas", "flood", "equipment", "sensor", "intrusion"],
      "propertyNames": {"pattern": "^(fire|gas|flood|equipment|sensor|intrusion)$"},
      "additionalProperties": false,
      "minProperties": 6
    },
    "reject_k": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "reject_types": {
      "type": "array", "minItems": 1,
      "items": {"enum": ["fire", "gas", "flood", "equipment", "sensor", "intrusion"]}
    },
    "max_share": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "threshold_window_days": {"type": "integer", "minimum": 1},
    "chatter_gap_hours": {"type": "integer", "minimum": 1},
    "mute_max_hours": {"type": "integer", "minimum": 0}
  }
}