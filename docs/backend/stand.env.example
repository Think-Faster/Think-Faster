# Образец stand.env для stand.yml и compose.yml. Сам stand.env в git не попадает (.gitignore).
# Значения — тестовые, только для стенда. Пароли — латиница и цифры: Kafka подставляет их в JAAS в кавычках.

# клоны репозиториев и пакет модели (bundle.py, ML/INTEGRATION.md §13.6)
TF_INFRA=C:/path/to/think-infra
TF_TEST=C:/path/to/think-test
TF_MODEL_BUNDLE_DIR=C:/path/to/bundle

# наши сервисы на стенде
TF_ENV=prod
TF_VAULT_ADDR=http://tf-vault:8200
TF_FUNNEL_PULL=http://tf-emulator:8000
TF_MODEL_CLOCK=live
TF_EMULATOR_PORT=8090

# Vault стенда (dev): корневой токен только для tf-vault-seed
TF_VAULT_ROOT_TOKEN=CHANGE_ME

# think-infra/kafka; KAFKA_CLUSTER_ID: docker run --rm apache/kafka:4.0.0 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=CHANGE_ME
TF_KAFKA_ADMIN_PASSWORD=CHANGE_ME
TF_KAFKA_FUNNEL_PASSWORD=CHANGE_ME
TF_KAFKA_MODEL_PASSWORD=CHANGE_ME
TF_KAFKA_BFF_PASSWORD=CHANGE_ME

# think-infra/rabbitmq
TF_RABBIT_ADMIN_PASSWORD=CHANGE_ME
TF_RABBIT_BFF_PASSWORD=CHANGE_ME
TF_RABBIT_MODEL_PASSWORD=CHANGE_ME
TF_RABBIT_EMAIL_PASSWORD=CHANGE_ME
TF_RABBIT_TELEGRAM_PASSWORD=CHANGE_ME

# PostgreSQL стенда и роль audit_writer
POSTGRES_PASSWORD=CHANGE_ME
TF_AUDIT_DB_PASSWORD=CHANGE_ME

# необязательно: ключ проверки токенов (PEM в кавычках), техучётки без scope, каналы уведомлений
TF_STAND_AUTH_PUBLIC_KEY=
TF_STAND_FUNNEL_SUBS=
TF_STAND_MODEL_SUBS=
TF_STAND_NOTIFY_SUBS=
TF_STAND_AUDIT_SUBS=
TF_STAND_SMTP_USER=
TF_STAND_SMTP_PASSWORD=
TF_STAND_TELEGRAM_BOT_TOKEN=
